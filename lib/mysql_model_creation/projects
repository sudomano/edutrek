-- DROP TABLE IF EXISTS `projects`;
CREATE TABLE `projects` (
  -- Primary Key
  `projectCode` varchar(255) NOT NULL,
  
  -- Core Fields
  `name` varchar(255) NOT NULL,
  `description` text DEFAULT NULL,
  `status` varchar(50) NOT NULL,
  
  -- Timestamps
  `createdAt` datetime NOT NULL,
  `updatedAt` datetime NOT NULL,
  
  -- ✅ NEW: Project Type Fields
  `projectType` varchar(50) NOT NULL DEFAULT 'sales', -- sales | service | mixed
  `participationType` varchar(50) NOT NULL DEFAULT 'optional', -- optional | compulsory
  `studentPayable` tinyint(1) DEFAULT 1,
  
  -- Sync & Audit Fields
  `syncStatus` tinyint(1) DEFAULT 0,
  `lastModified` datetime DEFAULT NULL,
  `operationType` varchar(50) DEFAULT NULL,
  `modifiedFields` json DEFAULT NULL, -- ✅ Changed from TEXT to JSON
  
  PRIMARY KEY (`projectCode`),
  KEY `idx_name` (`name`),
  KEY `idx_status` (`status`),
  KEY `idx_syncStatus` (`syncStatus`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;