-- DROP TABLE IF EXISTS `classes`;
CREATE TABLE `classes` (
  -- Primary & Identifiers
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `classCode` varchar(200) DEFAULT NULL,
  
  -- Class Information Fields (matching client exactly)
  `className` varchar(255) NOT NULL,
  `date` date NOT NULL,
  
  -- Academic Fields
  `termId` varchar(255) DEFAULT NULL,
  `terms` json DEFAULT NULL, -- ✅ Changed from TEXT to JSON for List support
  
  -- Sync & Audit Fields
  `operationType` varchar(200) DEFAULT 'none',
  `lastModified` datetime(6) DEFAULT current_timestamp(6),
  `syncStatus` tinyint(1) DEFAULT 0,
  `createdAt` timestamp NULL DEFAULT current_timestamp(),
  `updatedAt` timestamp NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  
  -- Foreign Keys & Other
  `fid` int(200) DEFAULT NULL,
  
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_classCode` (`classCode`),
  KEY `idx_className` (`className`),
  KEY `idx_syncStatus` (`syncStatus`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

